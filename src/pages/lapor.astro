---
import Base from '../layouts/Base.astro';
import { LAPOR_FORM_URL, SITE } from '../config';
import { TEKS, isi } from '../teks';
const T = TEKS.lapor;
---
<Base judul={TEKS.umum.menuLapor} halaman="lapor">
  <div class="prosa">
    <h1>{T.judul}</h1>
    <p>{isi(T.pengantar, { komunitas: SITE.oleh })}</p>
    {LAPOR_FORM_URL
      ? <p><a class="tombol" href={LAPOR_FORM_URL} target="_blank" rel="noopener">{T.tombol}</a></p>
      : <p class="peringatan">{isi(T.belumSiap, { komunitas: SITE.oleh })}</p>}
  </div>
</Base>

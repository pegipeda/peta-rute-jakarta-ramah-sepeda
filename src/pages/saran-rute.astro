---
import Base from '../layouts/Base.astro';
import { SARAN_RUTE_FORM_URL, SITE } from '../config';
import { TEKS, isi } from '../teks';
const T = TEKS.saranRute;
---
<Base judul={TEKS.umum.menuSaranRute} halaman="saran-rute">
  <div class="prosa">
    <h1>{T.judul}</h1>
    <p>{isi(T.pengantar, { komunitas: SITE.oleh })}</p>
    <h2>{T.judulIsi}</h2>
    <ul>{T.isi.map((b) => <li>{b}</li>)}</ul>
    <p class="redup kecil">{T.catatanPrivasi}</p>
    {SARAN_RUTE_FORM_URL
      ? <p><a class="tombol" href={SARAN_RUTE_FORM_URL} target="_blank" rel="noopener">{T.tombol}</a></p>
      : <p class="peringatan">{isi(T.belumSiap, { komunitas: SITE.oleh })}</p>}
  </div>
</Base>

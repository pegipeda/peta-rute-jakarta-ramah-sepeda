---
import Base from '../../layouts/Base.astro';
import Peta from '../../components/Peta.astro';
import { loadData, cpSlug, jalurSlug } from '../../lib/data';
import { FITUR } from '../../config';

// URL checkpoint (/cp/tgs-07/) dicetak di QR. Jangan mengubah pola ini.
export async function getStaticPaths() {
  const { checkpoints } = await loadData();
  return checkpoints.map((c) => ({ params: { id: cpSlug(c.id) }, props: { cpId: c.id } }));
}

const { cpId } = Astro.props;
const { checkpoints, jalur } = await loadData();
const c = checkpoints.find((x) => x.id === cpId)!;
const j = jalur.find((x) => x.id === c.jalur);
const terverifikasi = c.status === 'Terverifikasi';
const isi = (v: string) => (v && v !== 'Belum dicek' ? v : null);
---
<Base judul={c.nama} deskripsi={`${c.nama}, checkpoint ${j?.nama ?? ''}. ${c.kategori}, ${c.wilayah}.`}>
  <p class="redup kecil" style="margin-bottom:6px">
    {j ? <a href={`/jalur/${jalurSlug(j.id)}/`}>{j.nama}</a> : c.jalur} · {c.id}
  </p>
  <h1>{c.nama}</h1>
  <p style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px">
    <span class="chip">{c.kategori}</span>
    {c.kategoriLain && <span class="chip">{c.kategoriLain}</span>}
    {terverifikasi
      ? <span class="chip">Terverifikasi</span>
      : c.status === 'Perlu dicek ulang'
        ? <span class="chip waspada">Perlu dicek ulang</span>
        : <span class="chip draft">Belum diverifikasi</span>}
  </p>

  <div class="tata-cp">
    <div>
      <dl class="rincian">
        <dt>Wilayah</dt><dd>{c.wilayah}</dd>
        <dt>Alamat</dt><dd>{c.alamat}</dd>
        {c.jamBuka && <><dt>Jam buka</dt><dd>{c.jamBuka}</dd></>}
        <dt>Parkir sepeda</dt><dd>{isi(c.parkirSepeda) ?? <span class="redup">Belum dicek</span>}</dd>
        {c.kategori === 'Transit' && <><dt>Sepeda non-lipat</dt><dd>{c.sepedaNonLipat === 'Ya' ? 'Boleh dibawa' : c.sepedaNonLipat || 'Belum dicek'}</dd></>}
        {terverifikasi && c.diverifikasiTanggal && <><dt>Diverifikasi</dt><dd>{c.diverifikasiTanggal}{c.diverifikasiOleh ? ` oleh ${c.diverifikasiOleh}` : ''}</dd></>}
      </dl>
      {c.catatan && <p class="prosa">{c.catatan}</p>}
      {!terverifikasi && <p class="redup kecil prosa">Data titik ini belum dicek langsung di lapangan. Jam buka dan fasilitas bisa berbeda.</p>}
      <p style="display:flex;gap:10px;flex-wrap:wrap">
        {c.mapsUrl && <a class="tombol" href={c.mapsUrl} target="_blank" rel="noopener">Buka di Google Maps</a>}
        {j && <a class="tombol garis" href={`/jalur/${jalurSlug(j.id)}/`}>Lihat {j.nama}</a>}
      </p>
    </div>
    <div>
      <Peta label={`Lokasi ${c.nama}`} kecil titik={[{ id: c.id, nama: c.nama, kategori: c.kategori, lat: c.lat, lon: c.lon, url: `/cp/${cpSlug(c.id)}/` }]} />
      {FITUR.qr && (
        <div style="margin-top:20px">
          <div class="qr"><img src={`/qr/${cpSlug(c.id)}.svg`} alt={`QR menuju halaman ${c.nama}`} width="180" height="180" /></div>
          <p class="kecil redup" style="margin-top:8px"><a href={`/qr/${cpSlug(c.id)}.svg`} download={`qr-${cpSlug(c.id)}.svg`}>Unduh QR</a> untuk dicetak di lokasi.</p>
        </div>
      )}
    </div>
  </div>
</Base>

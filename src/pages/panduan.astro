---
import Base from '../layouts/Base.astro';
import { TEKS } from '../teks';
const T = TEKS.panduan;
---
<Base judul={T.judul} halaman="panduan">
  <div class="prosa">
    <h1>{T.judul}</h1>
    <p>{T.pembuka}</p>

    <h2 id="level">{T.judulLevel}</h2>
    <p>{T.pengantarLevel}</p>
    <div class="level" style="margin-bottom:32px">
      <div><i style="background:var(--teal)"></i><span><b>{T.level1Nama}</b> {T.level1Isi}</span></div>
      <div><i style="background:var(--mustard)"></i><span><b>{T.level2Nama}</b> {T.level2Isi}</span></div>
      <div><i style="background:var(--rose)"></i><span><b>{T.level3Nama}</b> {T.level3Isi}</span></div>
    </div>

    <h2 id="transum">{T.judulTransum}</h2>
  </div>
  <div class="tabel-wrap">
    <table>
      <thead><tr><th>{T.kolomModa}</th><th>{T.kolomLipat}</th><th>{T.kolomNonLipat}</th></tr></thead>
      <tbody>
        <tr><td><b>MRT Jakarta</b></td><td>Boleh</td><td>Hanya lewat 4 stasiun: Lebak Bulus, Blok M, Istora, dan Bundaran HI</td></tr>
        <tr><td><b>LRT Jabodebek</b></td><td>Boleh</td><td>Boleh di semua stasiun</td></tr>
        <tr><td><b>LRT Jakarta</b></td><td>Boleh</td><td>Lewat Stasiun Pegangsaan Dua dan Velodrome</td></tr>
        <tr><td><b>KRL Commuter Line</b></td><td>Boleh, dalam keadaan terlipat</td><td>Tidak boleh</td></tr>
      </tbody>
    </table>
  </div>
  <div class="prosa">
    <p class="redup kecil">{T.catatanTransum}</p>

    <h2 id="persiapan">{T.judulPersiapan}</h2>
    <p class="redup">{T.isiPersiapan}</p>
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import Peta from '../../components/Peta.astro';
import { loadData, jalurSlug, cpSlug } from '../../lib/data';
import { opsiJalur, type Opsi, type Ruas } from '../../lib/opsi';
import { titikCabang } from '../../lib/urutan';
import { TEKS, isi } from '../../teks';
import fs from 'node:fs';
// Garis cabang yang mengikuti jalan, dibuat dengan: npm run buat-cabang
const CABANG: Record<string, { coords: [number, number][]; jarakM: number }> =
  fs.existsSync('data/cabang.json') ? JSON.parse(fs.readFileSync('data/cabang.json', 'utf8')) : {};
const T = TEKS.jalur;

export async function getStaticPaths() {
  const { jalur } = await loadData();
  return jalur.map((j) => ({ params: { id: jalurSlug(j.id) }, props: { jalurId: j.id } }));
}

const { jalurId } = Astro.props;
const { checkpoints, jalur } = await loadData();
const j = jalur.find((x) => x.id === jalurId)!;
const opsi = opsiJalur(j.id, checkpoints);

// Tempat singgah: checkpoint bukan stasiun yang berada dekat ruas gowes.
const BATAS_SINGGAH_KM = 2;
const kandidatSinggah = checkpoints.filter((c) => c.kategori !== 'Transit');

const fmtKm = (km: number) => `${km.toLocaleString('id-ID', { maximumFractionDigits: 1 })} km`;
const fmtJarak = (m: number) => { const r = Math.round(m / 50) * 50; return r < 1000 ? `± ${r} m` : `± ${(m / 1000).toLocaleString('id-ID', { maximumFractionDigits: 1 })} km`; };
const arahkan = (dari: [number, number], lat: number, lon: number) =>
  `https://www.google.com/maps/dir/?api=1&origin=${dari[1]},${dari[0]}&destination=${lat},${lon}&travelmode=bicycling`;

type Titik = { nama: string; url?: string; ujung?: boolean; transit?: boolean; meta: string[]; seg: 'gowes' | 'kereta' | null };

function susunLin(o: Opsi): Titik[] {
  const out: Titik[] = [];
  const tambah = (t: Titik) => {
    const akhir = out[out.length - 1];
    const sama = akhir && akhir.nama.replace(/^Stasiun (MRT )?/, '').toLowerCase() === t.nama.replace(/^Stasiun (MRT )?/, '').toLowerCase();
    if (sama) { akhir.meta.push(...t.meta); akhir.seg = t.seg; akhir.transit ||= t.transit; akhir.url ||= t.url; }
    else out.push(t);
  };
  o.ruas.forEach((r: Ruas) => {
    if (r.jenis === 'gowes') {
      tambah({ nama: r.dari, meta: [isi(T.alurGowes, { km: fmtKm(r.jarakKm), ke: r.ke })], seg: 'gowes' });
      tambah({ nama: r.ke, meta: [], seg: null });
    } else {
      const s = r.stasiun;
      const lewat = s.length - 2;
      const keluarLain = s.slice(1, -1).filter((x) => x.nonLipat).map((x) => x.nama.replace(/^Stasiun (MRT )?/, ''));
      tambah({ nama: s[0].nama, url: s[0].cpId ? `/cp/${cpSlug(s[0].cpId)}/` : undefined, transit: true,
        meta: [lewat > 0 ? isi(T.alurNaikLewat, { moda: r.moda, n: lewat }) : isi(T.alurNaik, { moda: r.moda }), ...(keluarLain.length ? [isi(T.alurBisaTurun, { stasiun: keluarLain.join(', ') })] : [])], seg: 'kereta' });
      const z = s[s.length - 1];
      tambah({ nama: z.nama, url: z.cpId ? `/cp/${cpSlug(z.cpId)}/` : undefined, transit: true, meta: [T.alurTurun], seg: null });
    }
  });
  if (out.length) { out[0].ujung = true; out[out.length - 1].ujung = true; }
  return out;
}

const panel = opsi.map((o) => {
  const ruasGowes = o.ruas.filter((r) => r.jenis === 'gowes') as Extract<Ruas, { jenis: 'gowes' }>[];
  const singgah = kandidatSinggah
    .map((c) => {
      let terbaik = { jarakKm: Infinity, titik: [c.lon, c.lat] as [number, number], gpx: '' };
      for (const r of ruasGowes) {
        const t = titikCabang(c.lon, c.lat, r.coords);
        if (t.jarakKm < terbaik.jarakKm) terbaik = { ...t, gpx: r.gpx };
      }
      // Pakai garis cabang yang mengikuti jalan kalau sudah dihitung; kalau belum, garis lurus.
      const jalan = CABANG[`${c.id}|${terbaik.gpx}`];
      return {
        c,
        jarakLurusKm: terbaik.jarakKm,
        jarakKm: jalan ? jalan.jarakM / 1000 : terbaik.jarakKm,
        titik: jalan ? jalan.coords[0] : terbaik.titik,
        garis: jalan ? jalan.coords : [terbaik.titik, [c.lon, c.lat]] as [number, number][],
      };
    })
    .filter((s) => s.jarakLurusKm <= BATAS_SINGGAH_KM)
    .sort((a, b) => a.jarakKm - b.jarakKm);
  const lin = susunLin(o);
  const stasiunTitik = o.ruas.flatMap((r) => (r.jenis === 'kereta' ? [r.stasiun[0], r.stasiun[r.stasiun.length - 1]] : []));
  const awal = o.ruas[0], akhir = o.ruas[o.ruas.length - 1];
  const ujungTitik = [
    ...(awal.jenis === 'gowes' ? [{ nama: awal.dari, lon: awal.coords[0]?.[0], lat: awal.coords[0]?.[1] }] : []),
    ...(akhir.jenis === 'gowes' ? [{ nama: akhir.ke, lon: akhir.coords.at(-1)?.[0], lat: akhir.coords.at(-1)?.[1] }] : []),
  ].filter((t) => t.lon !== undefined);
  return {
    o, lin, singgah,
    peta: {
      garis: o.ruas.map((r) => ({ coords: r.coords, warna: r.jenis === 'gowes' ? j.warna : '#16201f', putus: r.jenis === 'kereta' })),
      titik: [
        ...ujungTitik.map((t) => ({ nama: t.nama, kategori: 'Titik awal / akhir', lat: t.lat!, lon: t.lon!, jenis: 'utama' as const })),
        ...stasiunTitik.map((s) => ({ nama: s.nama, kategori: 'Transit', lat: s.lat, lon: s.lon, url: s.cpId ? `/cp/${cpSlug(s.cpId)}/` : undefined, jenis: 'utama' as const })),
        ...singgah.map((s) => ({
          nama: s.c.nama, kategori: s.c.kategoriLain ? `${s.c.kategori} · ${s.c.kategoriLain}` : s.c.kategori,
          lat: s.c.lat, lon: s.c.lon, url: `/cp/${cpSlug(s.c.id)}/`, jenis: 'singgah' as const,
          cabang: { garis: s.garis, jarakM: s.jarakKm * 1000, arahkan: arahkan(s.titik, s.c.lat, s.c.lon) },
        })),
      ],
    },
  };
});
const adaDraft = opsi.some((o) => o.draft) || j.status === 'Draft';
---
<Base judul={j.nama} deskripsi={`${j.nama}: ${j.dari} – ${j.ke}. Pilihan gowes penuh atau kombinasi transportasi umum, dengan file GPX.`}>
  <div class="judul-jalur">
    <span class="warna" style={`background:${j.warna}`}></span>
    <div>
      <h1>{j.nama}</h1>
      <p class="redup" style="margin:0">{j.dari} – {j.ke} {adaDraft && <span class="chip draft">{T.labelDraft}</span>}</p>
    </div>
  </div>

  {adaDraft && (
    <div class="peringatan">
      <p><b>{T.draftJudul}</b> {T.draftIsi}</p>
    </div>
  )}

  {opsi.length > 1 && (
    <div class="tab" role="tablist" aria-label="Pilihan perjalanan">
      {opsi.map((o, i) => (
        <button role="tab" id={`tab-${o.id}`} aria-controls={`panel-${o.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          <b>{o.nama}</b><span>{o.sepeda}</span>
        </button>
      ))}
    </div>
  )}

  {panel.map(({ o, lin, singgah, peta }, i) => (
    <section class="panel-opsi" role={opsi.length > 1 ? 'tabpanel' : undefined} id={`panel-${o.id}`} aria-labelledby={opsi.length > 1 ? `tab-${o.id}` : undefined} hidden={i !== 0}>
      <p class="prosa">{o.ringkas}</p>
      <dl class="statistik">
        <div><dt>{o.draft ? T.statJarakDraft : T.statJarak}</dt><dd>{fmtKm(o.jarakGowesKm)}</dd></div>
        <div><dt>{T.statTanjakan}</dt><dd>{o.tanjakanM != null ? `${o.tanjakanM} m` : '—'}</dd></div>
        <div><dt>{T.statSepeda}</dt><dd style="font-size:1rem;padding-top:6px">{o.sepeda}</dd></div>
        <div><dt>{T.statMampir}</dt><dd>{singgah.length}</dd></div>
      </dl>
      <p style="display:flex;gap:10px;flex-wrap:wrap">
        {o.ruas.filter((r) => r.jenis === 'gowes').map((r) => (
          <a class="tombol" href={`/gpx/${r.gpx}`} download={r.gpx}>
            {o.ruas.length > 1 ? isi(T.tombolGpxRuas, { dari: r.dari, ke: r.ke }) : T.tombolGpx}
          </a>
        ))}
        {o.ruas.some((r) => r.jenis === 'kereta') && <a class="tombol garis" href="/panduan/#transum">{T.tombolTransum}</a>}
      </p>

      <div class="tata-jalur" style={`--warna-lin:${j.warna}`}>
        <div>
          <h2>{T.judulAlur}</h2>
          <ol class="lin">
            {lin.map((t) => (
              <li class:list={[{ ujung: t.ujung }, t.seg ? `seg-${t.seg}` : 'seg-akhir']}>
                <span class:list={['titik', { transit: t.transit }]}></span>
                {t.url ? <a href={t.url}>{t.nama}</a> : <span class="ujung-label">{t.nama}</span>}
                {t.meta.map((m) => <span class="meta">{m}</span>)}
              </li>
            ))}
          </ol>
          {o.ruas.filter((r) => r.jenis === 'kereta' && r.catatan).map((r) => (
            <p class="kecil redup">{(r as any).catatan}</p>
          ))}

          <h2 style="margin-top:28px">{T.judulMampir}</h2>
          {singgah.length === 0
            ? <p class="redup kecil">{T.mampirKosong}</p>
            : (
              [
                { judul: T.grupBengkel, isi: singgah.filter((s) => s.c.kategori === 'Bengkel' || s.c.kategoriLain === 'Bengkel') },
                { judul: T.grupLain, isi: singgah.filter((s) => !(s.c.kategori === 'Bengkel' || s.c.kategoriLain === 'Bengkel')) },
              ].filter((g) => g.isi.length).map((g) => (
              <>
              <h3 class="grup-mampir">{g.judul}</h3>
              <ul class="singgah">
                {g.isi.map((s) => (
                  <li>
                    <a href={`/cp/${cpSlug(s.c.id)}/`}>{s.c.nama}</a>
                    <span class="meta">{s.c.kategori}{s.c.kategoriLain ? ` · ${s.c.kategoriLain}` : ''} · {isi(T.mampirJarak, { jarak: fmtJarak(s.jarakKm * 1000) })}</span>
                    {s.c.jamBuka && <span class="meta">{s.c.jamBuka}</span>}
                    <a class="kecil" href={arahkan(s.titik, s.c.lat, s.c.lon)} target="_blank" rel="noopener">{T.mampirArahkan}</a>
                  </li>
                ))}
              </ul>
              </>
              ))
            )}
          <p class="kecil redup">{T.mampirCatatan}</p>
        </div>

        <div class="peta-wrap">
          <Peta label={`Peta ${j.nama}, ${o.nama}`} garis={peta.garis} titik={peta.titik} teks={{ dariRute: T.mampirJarak, arahkan: T.mampirArahkan }} />
        </div>
      </div>
    </section>
  ))}
</Base>

<script>
  // Tab pilihan perjalanan. Peta di panel yang baru tampil perlu diukur ulang.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tab [role="tab"]')];
  const pilih = (tab: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const aktif = t === tab;
      t.setAttribute('aria-selected', String(aktif));
      t.tabIndex = aktif ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls')!)!;
      panel.hidden = !aktif;
      if (aktif) {
        const el = panel.querySelector<HTMLElement>('[data-peta]') as any;
        setTimeout(() => { el?._peta?.resize(); el?._paskan?.(); }, 60);
      }
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => pilih(t));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        n.focus(); pilih(n);
      }
    });
  });
</script>
